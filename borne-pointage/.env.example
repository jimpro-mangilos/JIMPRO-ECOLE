# Copiez ce fichier en .env et remplissez (commun à l'agent Node ET au script Python)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=clé-anon-du-projet (même que l'app)
BORNE_EMAIL=borne@ecole.cd
BORNE_PASSWORD=***
ECOLE_ID=uuid-de-l-ecole (SELECT id FROM ecoles)

# ── Agent Node (agent-pointage.mjs) ──
APPAREIL_ID=borne1

# ── Script Python (sync-pointeuses.py) — optionnels ──
POLL_SECONDS=10          # intervalle de scrutation en secondes (0 = une seule passe)
DEVICE_PASSWORD=0        # mot de passe de communication des pointeuses ZKTeco (0 = aucun)
